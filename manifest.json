{
  "manifest_version": 3,
  "name": "Keepy Notes",
  "version": "0.2.0",
  "description": "Turns Google Keep into a three-column, Apple Notes style layout.",
  "browser_specific_settings": {
    "gecko": {
      "id": "keepy-notes@local",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Keepy Notes: click to turn off",
    "default_icon": "icons/keepy.svg"
  },
  "icons": {
    "48": "icons/keepy.svg",
    "96": "icons/keepy.svg"
  },
  "content_scripts": [
    {
      "matches": ["https://keep.google.com/*"],
      "css": ["styles.css"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
